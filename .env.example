# Web pública (enlaces de entradas asignadas: ${PUBLIC_WEB_URL}/t/<claimToken>)
PUBLIC_WEB_URL=https://nightvibe.life

# Revisión de fotos con IA (utils/photoReview.js). Sin clave, las fotos quedan
# en needs_review (las revisa el club) y la subida funciona igual.
ANTHROPIC_API_KEY=
# Modelo (por defecto claude-haiku-4-5). Para subirlo sin tocar código:
# claude-sonnet-5 o claude-opus-5. Comparar antes con scripts/reviewPhotosDryRun.js
PHOTO_REVIEW_MODEL=claude-haiku-4-5
# Aprobación automática de fotos de MISIÓN: confianza mínima de la IA (0..1).
# Por defecto 0.90. Un valor > 1 la desactiva. No afecta a la moderación ni al muro.
PHOTO_REVIEW_AUTO_APPROVE_MIN=0.90
# Revisiones simultáneas en segundo plano (por defecto 3)
PHOTO_REVIEW_CONCURRENCY=3

# Topes de entradas reservadas a la vez (sin pagar) por evento. Opcionales.
# Web (/api/payments/direct), por IP: generoso porque en la puerta del local
# mucha gente comparte IP (wifi del club, operadores móviles).
DIRECT_MAX_ACTIVE_PER_IP=30
# App (/api/payments/checkout), por usuario.
CHECKOUT_MAX_ACTIVE_PER_USER=20

# Administración (aprobar/rechazar solicitudes de clubs). Vale cualquiera de las dos.
# Sin ninguna definida, las rutas de administración responden 503 (cerradas).
# _id de Mongo de los usuarios administradores, separados por comas
ADMIN_USER_IDS=
# Clave para la cabecera X-Admin-Key (uso desde servidor o terminal; nunca en el portal)
ADMIN_API_KEY=
